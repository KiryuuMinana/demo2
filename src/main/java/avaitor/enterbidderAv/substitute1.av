## substitute1
## 候补规则：固定人数候补（即选择[1, Math.min(指定人数, 剩余人数)]）
## 参数说明：
##   total_person : 指定的候补人数上限
##   CR           : 当前已生成轮次（仅1轮，0表示尚未开始，1及以上表示已跑过）
##   IB           : 当前初始化的投标人列表
##                  若入围轮次详情表数据为空，则为自定义有效投标人列表；
##                  否则为自定义有效投标人列表与入围轮次详情表中所有已勾选入围投标单位的差集

fn substitute1(total_person, CR, IB) {

    ## 分支1：不是第一轮（候补仅1轮）
    if (CR != 0) {
        let result = seq.map();
        seq.put(result, "isOpen", false);               ## 本轮不开启
        seq.put(result, "checkStatus", -3);             ## -3：可能已勾选足够人数
        return result;
    } else {
        ## 分支2：开启候补本轮
        ## 可勾选人数 = Math.min(total_person, count(IB))
        let maxSelectable = count(IB);
        let checkableCount = total_person < maxSelectable ? total_person : maxSelectable;

        let result = seq.map();
        seq.put(result, "isOpen", true);                ## 开启本轮
        seq.put(result, "currentRound", CR + 1);        ## 当前轮次（第一轮=1）
        seq.put(result, "checkStatus", -2);             ## -2：至少勾选1人
        seq.put(result, "checkableCount", checkableCount); ## 可勾选人数上限 = Math.min(指定人数, 剩余人数)
        let IbList = seq.list();
        for ib_item in IB {
            seq.add(IbList, seq.map('id', ib_item, 'checked', 0));
        }
        seq.put(result, "IbList", IbList);              ## 页面展示候补人列表，全部不打钩
        return result;
    }
}

return substitute1(total_person, CR, IB);
