fn bl_filterHL_X(arr, X) {
    let list = seq.list();
    let num = count(arr);
    if (X > num) {
        X = num;
    }
    let lim = num - X;
    let min = math.ceil(lim/2.0);
    let max = num - math.floor(lim/2.0);

    arr = sort(arr, comparator(lambda(x, y) -> decimal(x.price) > decimal(y.price) end));
    for i in range(min, max){
        seq.add(list,arr[i]);
    }
    for i in range(0, min){
    	let arg = arr[i];
	    arg.maxFilter = true;
  	}
  	for i in range(max, num){
    	let arg = arr[i];
    	arg.minFilter = true;
  	}
    p("#{count(list)}");
    return list;
}

return bl_filterHL_X(arr,X);