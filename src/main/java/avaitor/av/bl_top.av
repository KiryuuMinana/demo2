## 取列表前n名价格，遇到分值相同应保留
## 若price[i,i+1,...,m] ==price[n],其中i=n+1，则bl_top返回的截取列表中应包含price[i],price[i+1],...,price[m]

use com.glodon.gbes.exception.AlgorithmFMinIndexOutOfBoundException;
fn bl_top(list, n){
    let result = seq.list();
    let num = count(list);
    if(n < 1 || n > num){
        p("超出范围");
        throw new AlgorithmFMinIndexOutOfBoundException();
    }

    list = sort(list, comparator(lambda(x, y) -> x.price > y.price end));
    p(list);
    p("=======================");
    for i in range(0,n){
        seq.add(result,list[i]);
    }
    let nprice = list[n - 1];
    for i in range(n,num){
        let iprice = list[i];
        if(iprice.price == nprice.price){
            seq.add(result,list[i]);
        }
    }

    return result;
}

return bl_top(list, n);




