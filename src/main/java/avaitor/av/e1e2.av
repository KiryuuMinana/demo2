fn range(param1,param2){
    if(param2 == nil){
        return "^(?!0(\.0{1,2})?$)([0-9]?(\.\d{1,2})?|10(\.0{1,2})?)$";
    }
    if(param1 > param2){
        return "^(?!0(\.0{1,2})?$)([0-9]?(\.\d{1,2})?|10(\.0{1,2})?)$";
    }else{
        return "^99999999999999999999999999999999999999999999999999$";
    }

}

return range(E1,E2);

fn range(param1,param2) {
    if(param2 == nil) {
        return "^(?!0(\.0{1,2})?$)([0-9]?(\.\d{1,2})?|10(\.0{1,2})?)$";
    }
    if(param1>param2) {
        return "^(?!0(\.0{1,2})?$)([0-9]?(\.\d{1,2})?|10(\.0{1,2})?)$";
    } else {
        return "^999999999999998888999$";
    }
}

return range(E1,E2);

## 校验E1
## fn rangeE1E2(param1,param2) { if(param2 == nil) { return "^(?!0(\\.0{1,2})?$)([0-9]?(\\.\\d{1,2})?|10(\\.0{1,2})?)$";} if(param1>param2) {return "^(?!0(\\.0{1,2})?$)([0-9]?(\\.\\d{1,2})?|10(\\.0{1,2})?)$";} else {return "999999999999988999";}} return rangeE1E2(E1,E2);
## 校验E2
## fn rangeE1E2(param1,param2) { if(param2 == nil) { return "^(?!0(\\.0{1,2})?$)([0-9]?(\\.\\d{1,2})?|10(\\.0{1,2})?)$";} if(param1>param2) {return "^(?!0(\\.0{1,2})?$)([0-9]?(\\.\\d{1,2})?|10(\\.0{1,2})?)$";} else {return "^999999999999998888999$";} } return rangeE1E2(E1,E2);

