fn custom_qs_yc_B0010101(list, score, param1, param2){
    QSn = nil;
    for key in list{
        if QSn == nil {
            QSn = seq.list();
        }
		QS = 0.0M;
		if key.price == 0 {
		    QS = score;
		}
		if key.price > 0 {
		    QS = score - key.price * 100.0M * param1;
		}
		if key.price < 0 {
		    QS = score + key.price * 100.0M * param2;
		}
		seq.add(QSn, seq.map("id", key.id, "price", max(QS, 0)));
	}
	return QSn;
}

custom_qs_yc_B0010101(DR,score,E1,E2);